CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The USB-C port belongs to TinyUSB (HID x2 + CDC), so the USB Serial/JTAG
# console is gone once the app runs. Logs go to the CDC interface (log.c).
CONFIG_ESP_CONSOLE_NONE=y

# 1 ms scheduler tick so that the main loop can sleep in 1 ms steps.
CONFIG_FREERTOS_HZ=1000

CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# BLE central, NimBLE host on CPU0 (decision I2). The peripheral role is on
# only because NimBLE's GATT server needs it: devices ask us GATT questions
# and drop the link if unanswered (q31-results.md §3). We never advertise.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_MAX_BONDS=15
# One accept-list entry per bonded device (the S3 controller allows 15).
CONFIG_BT_NIMBLE_WHITELIST_SIZE=15
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=8
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# NimBLE's own retry after a failed connection establishment (0x3E) would
# run alongside ble.c's reconnect, which already handles the disconnect
# (ble-connect-prior-art.md §4). Only ble.c starts connections.
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

# Screen (M3): LVGL uses the system heap, not its own 64 KB pool; the fonts
# ui.c uses; a 16-bit colour depth for the GC9A01.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
