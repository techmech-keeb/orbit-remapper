# Candidate fix for the MD600 dropping the link every 30 s: build NimBLE's
# GATT server (it needs the peripheral role) so ATT requests from a device
# get an answer. The program still never advertises. Layered on top of
# sdkconfig.defaults.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
