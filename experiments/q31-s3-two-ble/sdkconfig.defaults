CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# M5Dial: logs and flashing go through the USB-C of the M5StampS3 (USB Serial/JTAG).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# BLE central only, NimBLE host. Wi-Fi is never initialised by the application.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=8

# Keep bonds across reboots (brief 3-5).
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y

# NimBLE's own INFO logs would flood the 1 s report lines.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
